+/*
+==============================================================================
+
+THE CONSOLE WINDOW OF THE MENU OF THE STEAM VERSION (steamui_int.h)
+
+==============================================================================
+*/
+/*
+================
+Con_SteamReplay
+
+the text printed before the menu was loaded, for its console window
+================
+*/
+void Con_SteamReplay( void )
+{
+	if( !con.initialized || !con.buffer )
+		return;
+
+	for( int i = 0; i < CON_LINES_COUNT; i++ )
+	{
+		const con_lineinfo_t *l = &CON_LINES( i );
+		char line[MAX_PRINT_MSG + 2];
+		size_t len = Q_min( l->length, sizeof( line ) - 2 );
+
+		memcpy( line, l->start, len );
+		if( !l->wrapped )
+			line[len++] = '\n';
+		line[len] = '\0';
+		UI_SteamConsolePrint( line );
+	}
+}
+
+/*
+================
+Con_SteamCommand
+
+a line typed in the console window of the menu
+================
+*/
+void GAME_EXPORT Con_SteamCommand( const char *line )
+{
+	field_t f;
+
+	if( !line )
+		return;
+
+	Con_ClearField( &f );
+	f.cursor = Q_strncpy( f.buffer, line, sizeof( f.buffer ));
+	COM_RemoveLineFeed( f.buffer, sizeof( f.buffer ));
+
+	// echo as the console of GoldSrc does
+	Con_Printf( "] %s\n", f.buffer );
+
+	if( f.buffer[0] == '\\' || ( f.buffer[0] == '/' && f.buffer[1] != '/' ))
+		Cbuf_AddText( f.buffer + 1 );
+	else Cbuf_AddText( f.buffer );
+	Cbuf_AddText( "\n" );
+
+	if( !con.historyLoaded )
+	{
+		Con_LoadHistory( &con.history );
+		con.historyLoaded = true;
+	}
+	Con_HistoryAppend( &con.history, &f );
+}
+
+typedef struct
+{
+	const char *partial;
+	size_t      len;
+	string      names[64];
+	string      values[64];
+	int         count;
+	int         max;
+} steamcompletion_t;
+
+static void Con_SteamCompletionAdd( steamcompletion_t *c, const char *name, const char *value )
+{
+	int i, j;
+
+	if( !name || Q_strnicmp( name, c->partial, c->len ))
+		return;
+
+	// already there (an alias and a command of the same name)
+	for( i = 0; i < c->count; i++ )
+		if( !Q_stricmp( c->names[i], name ))
+			return;
+
+	// sorted, the first "max" of them
+	for( i = 0; i < c->count; i++ )
+		if( Q_stricmp( name, c->names[i] ) < 0 )
+			break;
+
+	if( i >= c->max )
+		return;
+
+	if( c->count < c->max )
+		c->count++;
+
+	for( j = c->count - 1; j > i; j-- )
+	{
+		Q_strncpy( c->names[j], c->names[j - 1], sizeof( c->names[j] ));
+		Q_strncpy( c->values[j], c->values[j - 1], sizeof( c->values[j] ));
+	}
+
+	Q_strncpy( c->names[i], name, sizeof( c->names[i] ));
+	if( value )
+		Q_strncpy( c->values[i], value, sizeof( c->values[i] ));
+	else c->values[i][0] = '\0';
+}
+
+static void Con_SteamCompletionCmd( const char *name, const void *func, const void *unused, void *ptr )
+{
+	steamcompletion_t *c = ptr;
+
+	// no hidden commands
+	if( !name || name[0] == '_' || name[0] == '@' )
+		return;
+
+	Con_SteamCompletionAdd( c, name, NULL );
+}
+
+static void Con_SteamCompletionVar( const char *name, const void *value, const void *unused, void *ptr )
+{
+	steamcompletion_t *c = ptr;
+	convar_t *cv = Cvar_FindVar( name );
+
+	if( cv && FBitSet( cv->flags, FCVAR_PROTECTED ))
+		value = NULL; // a password: its value is not shown
+
+	Con_SteamCompletionAdd( c, name, value ? value : "" );
+}
+
+/*
+================
+Con_SteamCompletion
+
+the commands and the variables beginning with "partial" (see steamui_int.h)
+================
+*/
+int GAME_EXPORT Con_SteamCompletion( const char *partial, char *out, int outsize, int max )
+{
+	steamcompletion_t *c;
+	size_t pos = 0;
+	int count;
+
+	if( !out || outsize <= 0 )
+		return 0;
+	out[0] = '\0';
+
+	if( !partial || !partial[0] )
+		return 0;
+
+	c = Mem_Calloc( host.mempool, sizeof( *c ));
+	c->partial = partial;
+	c->len = Q_strlen( partial );
+	c->max = bound( 1, max, (int)ARRAYSIZE( c->names ));
+
+	Cmd_LookupCmds( NULL, c, Con_SteamCompletionCmd );
+	Cvar_LookupVars( 0, NULL, c, Con_SteamCompletionVar );
+
+	for( int i = 0; i < c->count; i++ )
+	{
+		int n;
+		if( Cvar_FindVar( c->names[i] ))
+			n = Q_snprintf( out + pos, outsize - pos, "%s\t%s\n", c->names[i], c->values[i] );
+		else
+			n = Q_snprintf( out + pos, outsize - pos, "%s\n", c->names[i] );
+
+		if( n < 0 || pos + n >= (size_t)outsize )
+		{
+			out[pos] = '\0';
+			break;
+		}
+		pos += n;
+	}
+
+	count = c->count;
+	Mem_Free( c );
+	return count;
+}
