+/*
+=========================
+Voice_Test
+
+the test of the microphone of the menu: 1 starts it (the voice system is started for it when not on a server),
+0 stops it; returns 1 while the microphone records
+=========================
+*/
+int Voice_Test( int start )
+{
+	if( !start )
+	{
+		if( voicetest.active )
+		{
+			voicetest.active = false;
+			Voice_RecordStop();
+			if( voicetest.own_init && cls.state != ca_active )
+				Voice_Shutdown();
+		}
+		voicetest.own_init = false;
+		voicetest.level = 0.0f;
+		return 0;
+	}
+
+	if( voicetest.active )
+		return 1;
+
+	if( !voice.initialized )
+	{
+		if( !Voice_Init( VOICE_DEFAULT_CODEC, 3, false ))
+			return 0;
+		voicetest.own_init = true;
+	}
+
+	if( !voice.device_opened )
+	{
+		Voice_Test( 0 );
+		return 0;
+	}
+
+	Voice_RecordStart();
+	voicetest.active = Voice_IsRecording() && !voice.input_file;
+	if( !voicetest.active )
+		Voice_Test( 0 );
+	return voicetest.active;
+}
+
+float Voice_TestLevel( void )
+{
+	return voicetest.active ? bound( 0.0f, voicetest.level, 1.0f ) : 0.0f;
 }
 
