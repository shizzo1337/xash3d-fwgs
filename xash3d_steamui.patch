+/*
+==================
+CL_SteamLoadingBegin
+
+the loading window of the menu of the Steam version (steamui_int.h): the menu stays open while the client connects
+and loads, with the window over it; "server" is NULL for the local server. False when the menu can't do it.
+==================
+*/
+qboolean CL_SteamLoadingBegin( const char *server, qboolean changelevel )
+{
+	if( !UI_SteamFeature( STEAMUI_FEATURE_LOADING ) || cls.demoplayback || cls.changedemo )
+		return false;
+
+	if( cls.key_dest != key_menu )
+		UI_SetActiveMenu( true );
+
+	if( changelevel )
+		UI_ConnectionProgress_ChangeLevel();
+	else UI_ConnectionProgress_Connect( server );
+
+	cls.steam_loading = true;
+	cls.steam_downloading = false;
+	cls.steam_dltotal = 0;
+	return true;
+}
+
+/*
+==================
+CL_SteamLoadingFrame
+
+the files downloaded while connecting, for the loading window
+==================
+*/
+static void CL_SteamLoadingFrame( void )
+{
+	if( !cls.steam_loading )
+		return;
+
+	if( scr_download.value >= 0.0f && host.downloadfile[0] )
+	{
+		int current;
+
+		cls.steam_dltotal = Q_max( cls.steam_dltotal, host.downloadcount );
+		cls.steam_downloading = true;
+
+		current = bound( 0, cls.steam_dltotal - host.downloadcount, Q_max( 0, cls.steam_dltotal - 1 ));
+		UI_ConnectionProgress_Download( host.downloadfile, cls.servername, "", current, Q_max( 1, cls.steam_dltotal ), "" );
+	}
+	else if( cls.steam_downloading && host.downloadcount <= 0 )
+	{
+		cls.steam_downloading = false;
+		cls.steam_dltotal = 0;
+		UI_ConnectionProgress_DownloadEnd();
+	}
+}
